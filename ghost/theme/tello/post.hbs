{{!< default}}

{{#post}}
<article class="post">
    <header class="post__header">
        {{#if primary_tag}}
            <a class="tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
        {{/if}}
        <h1 class="post__title">{{title}}</h1>
        <div class="post__meta">
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY년 M월 D일"}}</time>
            <span>{{reading_time minute="1분" minutes="%분"}}</span>
            {{#primary_author}}<span>{{name}}</span>{{/primary_author}}
        </div>
    </header>

    {{#if feature_image}}
        <figure class="post__feature">
            <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        </figure>
    {{/if}}

    <div class="post__content">
        {{content}}
    </div>

    {{#if tags}}
        <footer class="post__footer">
            {{#foreach tags}}
                <a class="tag" href="{{url}}">{{name}}</a>
            {{/foreach}}
        </footer>
    {{/if}}
</article>
{{/post}}
