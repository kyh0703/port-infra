# Local API template. Copy to api.local.env and replace credential values locally.
NODE_ENV=local
PORT=8000
GRPC_PORT=8080
# Compose fixes this to the ingress peer; do not trust a whole private range.
API_TRUSTED_PROXY_CIDRS=172.30.40.2/32
DATABASE_URL=postgresql://port:port_local_password@postgres:5432/port
REDIS_URL=redis://redis:6379
# Audio persists in the voice_preview_cache volume; cached replay is not rate-limited.
VOICE_PREVIEW_USER_GENERATION_LIMIT=10
VOICE_PREVIEW_GLOBAL_GENERATION_LIMIT=60
RAG_URL=http://rag:8000
# Match the HTTPS authority configured by INGRESS_PUBLIC_AUTHORITY in the root .env.
WEB_ORIGIN=https://macbookpro.tail9f349d.ts.net:8443
API_PUBLIC_BASE_URL=https://macbookpro.tail9f349d.ts.net:8443
GOOGLE_OAUTH_WEB_ORIGIN=https://macbookpro.tail9f349d.ts.net:8443
WEB_ALLOWED_ORIGINS=
AUTH_PASSWORD_RESET_SECRET=local-dev-password-reset-secret-32b
AUTH_EMAIL_VERIFICATION_SECRET=local-dev-email-verification-secret-32b
AUTH_RATE_LIMIT_SECRET=local-dev-rate-limit-secret-32bytes
WEB_CHAT_RESUME_TOKEN_SECRET=local-dev-chat-resume-token-secret-32b
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=604800
# Required LiveKit Cloud project credentials; use the same values in the worker env.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_RUNTIME_CREDENTIAL_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
RAG_RETRIEVAL_CAPABILITY_SECRET=replace-with-a-local-secret-of-32-bytes
# Server-only business-network policy; never put this in worker/child config.
API_TOOL_ALLOWED_PRIVATE_ORIGINS=http://office-api-mock.test:8080
# Optional API-only SMS gateway: WIDESHOT_BASE_URL (HTTPS), WIDESHOT_API_KEY,
# WIDESHOT_SMS_CALLBACK_NUMBER (8-11 digits), WIDESHOT_RESELLER_CODE,
# WIDESHOT_TIMEOUT_MS (default 10000). No test value is a provider acceptance proof.
# HA API control/launcher keys and acceptance file are operator-managed:
# RUNTIME_CONTROL_KEY, RUNTIME_LAUNCHER_KEY, RUNTIME_CAPABILITY_EVIDENCE_PATH,
# RUNTIME_CAPABILITY_EVIDENCE_ID, RUNTIME_CAPABILITY_EVIDENCE_SHA256,
# RUNTIME_LIVEKIT_PROVIDER, RUNTIME_LIVEKIT_PROJECT_ID, RUNTIME_ENVIRONMENT_ID and exact image build inventory.
# First enabling also requires the approved immutable original cutover artifact:
# RUNTIME_FIRST_CUTOVER_EVIDENCE_PATH, RUNTIME_FIRST_CUTOVER_EVIDENCE_ID,
# RUNTIME_FIRST_CUTOVER_EVIDENCE_SHA256, RUNTIME_ORIGINAL_IDENTITIES_SHA256
# (canonical nonsecret identity pins, never a hash/export of raw keys).
# Later resume retains that exact attestation, rechecks current proof, and never rotates again.
