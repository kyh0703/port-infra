# Dev-only defaults. Copy this file to api.env and replace credential values locally.
PORT=8000
GRPC_PORT=8080
DATABASE_URL=postgresql://port:port_local_password@postgres:5432/port
REDIS_URL=redis://redis:6379
RAG_URL=http://rag:8000
KEYCLOAK_ISSUER_URL=http://macbookpro:18080/realms/overthinker
KEYCLOAK_AUDIENCE=overthinker-api
KEYCLOAK_ROLE_CLIENT_ID=overthinker-api
KEYCLOAK_CLIENT_ID=overthinker-api-bff
KEYCLOAK_CLIENT_SECRET=overthinker-local-bff-secret
KEYCLOAK_REDIRECT_URI=http://macbookpro:3000/api/v1/auth/callback
KEYCLOAK_TRANSACTION_SECRET=replace-with-a-local-secret-of-32-bytes
LIVEKIT_URL=ws://macbookpro:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
VOICE_RUNTIME_CREDENTIAL_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
USER_PII_ENCRYPTION_KEY=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
KEYCLOAK_SESSION_COOKIE_SECURE=false
WEB_ORIGIN=http://macbookpro:3000
