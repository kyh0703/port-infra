# Dev-only defaults. Copy this file to api.env and replace credential values locally.
NODE_ENV=local
PORT=8000
GRPC_PORT=8080
DATABASE_URL=postgresql://port:port_local_password@postgres:5432/port
REDIS_URL=redis://redis:6379
RAG_URL=http://rag:8000
WEB_ORIGIN=http://macbookpro:3000
AUTH_PASSWORD_RESET_SECRET=local-dev-password-reset-secret-32b
AUTH_EMAIL_VERIFICATION_SECRET=local-dev-email-verification-secret-32b
AUTH_RATE_LIMIT_SECRET=local-dev-rate-limit-secret-32bytes
WEB_CHAT_RESUME_TOKEN_SECRET=local-dev-chat-resume-token-secret-32b
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=604800
LIVEKIT_URL=ws://macbookpro:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
VOICE_RUNTIME_CREDENTIAL_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
RAG_RETRIEVAL_CAPABILITY_SECRET=replace-with-a-local-secret-of-32-bytes
