{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "port:runtime-ha:acceptance-evidence:v1",
  "type": "object",
  "required": ["schemaVersion", "evidenceId", "provider", "projectId", "environmentId", "protocolRevision", "observedAt", "expiresAt", "builds", "gates"],
  "properties": {
    "schemaVersion": {"const": 1},
    "evidenceId": {"type": "string", "format": "uuid"},
    "provider": {"const": "livekit-cloud"},
    "projectId": {"type": "string", "minLength": 1},
    "railwayProjectId": {"type": "string", "minLength": 1},
    "environmentId": {"type": "string", "minLength": 1},
    "protocolRevision": {"const": "runtime-recovery-v1"},
    "observedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "expiresAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "builds": {"type": "array", "minItems": 1, "items": {"$ref": "runtime-provider.schema.json#/$defs/build"}},
    "gates": {
      "type": "object",
      "required": ["cloudAssignmentFreshness", "cloudAbsentParticipantRevocation", "cloudTokenRefreshRevocation", "railwayPlacement", "railwaySignalGrace", "postgresqlFailoverDurability", "redisStateLoss", "productionSealAvailability"],
      "properties": {
        "cloudTokenRefreshRevocation": {
          "allOf": [
            {"$ref": "#/$defs/gate"},
            {
              "if": {"properties": {"status": {"const": "observed"}}, "required": ["status"]},
              "then": {"required": ["clockBound"]}
            }
          ],
          "properties": {"clockBound": {"$ref": "#/$defs/clockBound"}}
        }
      },
      "additionalProperties": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "clockBound": {
      "type": "object", "additionalProperties": false,
      "description": "Measured provider clock/refresh skew plus maximum revoke RPC duration must fit the 60000ms cutoff window; runtime consumer enforces the sum.",
      "required": ["maxProviderClockSkewMs", "maxRevocationRpcDurationMs"],
      "properties": {
        "maxProviderClockSkewMs": {"type": "integer", "minimum": 0, "maximum": 59999},
        "maxRevocationRpcDurationMs": {"type": "integer", "minimum": 1, "maximum": 60000}
      }
    },
    "gate": {
      "type": "object",
      "required": ["status", "scenario", "artifacts"],
      "properties": {
        "status": {"enum": ["unproven", "observed"]},
        "scenario": {"type": ["string", "null"]},
        "observedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "approvalSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "observed"}}},
          "then": {
            "required": ["observedAt", "approvalSha256"],
            "properties": {"scenario": {"type": "string", "minLength": 1}, "artifacts": {"minItems": 2}}
          }
        }
      ]
    }
  }
}
