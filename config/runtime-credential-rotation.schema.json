{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:port:runtime-credential-rotation:v1",
  "title": "Approved exposed-runtime credential rotation and provider readback",
  "oneOf": [
    { "$ref": "#/$defs/approval" },
    { "$ref": "#/$defs/providerResult" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^/", "minLength": 2 },
    "credentialClasses": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/credentialClass" }
    },
    "credentialClass": {
      "type": "string",
      "enum": ["livekit-project", "rag-global", "internal-api-global", "api-tool-provider", "sms-provider", "mcp-provider", "a2a-provider", "speech-provider", "model-provider"]
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "redacted"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" },
        "redacted": { "const": true }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "environmentId", "approvedBy", "expiresAt", "command", "credentialClasses", "resultFile"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": { "const": "rotate-exposed-runtime-credentials" },
        "environmentId": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "command": {
          "type": "array", "minItems": 1,
          "prefixItems": [{ "$ref": "#/$defs/path" }],
          "items": { "type": "string" }
        },
        "credentialClasses": { "$ref": "#/$defs/credentialClasses" },
        "resultFile": { "$ref": "#/$defs/path" }
      }
    },
    "providerReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["credentialClass", "provider", "receiptId", "status", "revocationVerified", "replacementVerified", "oldCredentialDenied", "newCredentialAccepted", "artifacts"],
      "properties": {
        "credentialClass": { "$ref": "#/$defs/credentialClass" },
        "provider": { "type": "string", "minLength": 1 },
        "receiptId": { "type": "string", "minLength": 1 },
        "status": { "const": "revoked-and-replaced" },
        "revocationVerified": { "const": true },
        "replacementVerified": { "const": true },
        "oldCredentialDenied": { "const": true },
        "newCredentialAccepted": { "const": true },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "providerResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "scope", "environmentId", "credentialClasses", "status", "observedAt", "providerReceipts"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": { "const": "rotate-exposed-runtime-credentials" },
        "environmentId": { "type": "string", "minLength": 1 },
        "credentialClasses": { "$ref": "#/$defs/credentialClasses" },
        "status": { "enum": ["unproven", "observed"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "providerReceipts": { "type": "array", "items": { "$ref": "#/$defs/providerReceipt" } }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "observed" } }, "required": ["status"] },
        "then": { "properties": { "providerReceipts": { "minItems": 1 } } }
      }]
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "scope", "environmentId", "approvalPath", "approvalSha256", "credentialClasses", "observedAt", "commandExitCode", "providerVerification", "resultFile"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": { "const": "rotate-exposed-runtime-credentials" },
        "environmentId": { "type": "string", "minLength": 1 },
        "approvalPath": { "$ref": "#/$defs/path" },
        "approvalSha256": { "$ref": "#/$defs/digest" },
        "credentialClasses": { "$ref": "#/$defs/credentialClasses" },
        "observedAt": { "type": "string", "format": "date-time" },
        "commandExitCode": { "type": ["integer", "null"] },
        "providerVerification": { "enum": ["unproven", "observed"] },
        "resultFile": { "$ref": "#/$defs/path" },
        "resultSha256": { "$ref": "#/$defs/digest" }
      },
      "allOf": [{
        "if": { "properties": { "providerVerification": { "const": "observed" } }, "required": ["providerVerification"] },
        "then": { "required": ["resultSha256"], "properties": { "commandExitCode": { "const": 0 } } }
      }]
    }
  }
}
