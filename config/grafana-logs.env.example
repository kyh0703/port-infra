# Copy to config/grafana-logs.env (gitignored). Never store the token here.
GRAFANA_CLOUD_LOGS_URL=https://YOUR-LOGS-HOST/loki/api/v1/push
GRAFANA_CLOUD_LOGS_USER=YOUR-LOGS-TENANT-ID
# Absolute path outside Git; file contains only the logs:write token (mode 0600).
GRAFANA_CLOUD_LOGS_TOKEN_FILE=/absolute/private/path/grafana-logs-token
ALLOY_TARGET_PROJECT=infra
ALLOY_ENVIRONMENT=local
# Docker socket path on the Docker daemon host, not the macOS CLI socket.
ALLOY_DOCKER_SOCKET=/var/run/docker.sock
