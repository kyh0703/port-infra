# Copy to voice-agent.local.env and set the same LiveKit Cloud credentials as the API.
VOICE_RUNTIME_GRPC_ADDR=api:8080
REDIS_URL=redis://redis:6379
METRICS_PORT=9091
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Actual declared provider/project/environment binding; OSS is startup-only, never Cloud proof.
RUNTIME_LIVEKIT_PROVIDER=livekit-cloud
RUNTIME_LIVEKIT_PROJECT_ID=
RUNTIME_ENVIRONMENT_ID=
PORT=8000
SDK_HTTP_PORT=8081
RUNTIME_POOL_ID=voice-agent
# Parent-only key; use an explicit approved runtime cutover, never a job/global key.
RUNTIME_LAUNCHER_KEY=
INTERNAL_API_BASE_URL=http://api:8000/api/v1
# Pin the exact immutable deployed image. Build/fingerprint come from its baked inventory.
RUNTIME_IMAGE_DIGEST=
