# Default local Docker environment.
# Copy to .env and override only values that differ on your machine.

# Required server-only secret. Run python3 scripts/init-internal-key.py after copying.
INTERNAL_SERVER_KEY=

# Compose host ports
REDIS_PORT=6379
POSTGRES_PORT=15432
PGADMIN_PORT=5050
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000

# PostgreSQL
POSTGRES_DB=port
POSTGRES_USER=port
POSTGRES_PASSWORD=port_local_password

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Optional observability profile
PROMETHEUS_CPU_LIMIT=0.5
PROMETHEUS_MEMORY_LIMIT=512M
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_CPU_LIMIT=0.5
GRAFANA_MEMORY_LIMIT=512M

# Application image configuration. Set *_ENV_FILE to a host-local env file when
# credentials or machine-specific values are needed.
API_ENV_FILE=./config/api.env.example
WEB_ENV_FILE=./config/web.env.example
RAG_ENV_FILE=./config/rag.env.example
VOICE_AGENT_ENV_FILE=./config/voice-agent.env.example
AGGREGATOR_ENV_FILE=./config/aggregator.env.example
ADAPTOR_ENV_FILE=./config/adaptor.env.example
VOICE_AGENT_CONFIG_FILE=./config/voice-agent.local.example.yaml

# Optional local telephony profile (dev credentials only)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_SIP_HEALTH_PORT=18090
LIVEKIT_SIP_PORT=15090
LIVEKIT_SIP_RTP_PORT=15000
LIVEKIT_SIP_RTP_END_PORT=15009
ASTERISK_SIP_PORT=15060
ASTERISK_RTP_PORT=15100
ASTERISK_RTP_END_PORT=15109

# Application host ports
API_PORT=8000
API_GRPC_PORT=8080
RAG_PORT=8001
VOICE_AGENT_METRICS_PORT=19091
AGGREGATOR_PORT=3001
