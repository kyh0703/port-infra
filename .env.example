# Default local Docker environment.
# Copy to .env and override only values that differ on your machine.

# Required server-only secret. Run python3 scripts/init-internal-key.py after copying.
INTERNAL_SERVER_KEY=

# Compose host ports
REDIS_PORT=6379
POSTGRES_PORT=15432
PGADMIN_PORT=5050
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
OPENBAO_PORT=18200
# OpenBao seal mode: shamir (default) or static (Mac Keychain controller).
OPENBAO_SEAL_MODE=shamir

# PostgreSQL
POSTGRES_DB=port
POSTGRES_USER=port
POSTGRES_PASSWORD=port_local_password

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Optional local blog profile. Change both URL and port when using another port.
# Replace both passwords before exposing the blog beyond localhost.
GHOST_BIND_HOST=127.0.0.1
GHOST_PORT=2368
GHOST_URL=http://localhost:2368
GHOST_DB_PASSWORD=ghost_local_password
GHOST_DB_ROOT_PASSWORD=ghost_local_root_password

# Optional observability profile
PROMETHEUS_CPU_LIMIT=0.5
PROMETHEUS_MEMORY_LIMIT=512M
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_CPU_LIMIT=0.5
GRAFANA_MEMORY_LIMIT=512M

# Application image configuration. Examples are selected here for Compose config
# validation. For runtime, create config/api.local.env and
# config/voice-agent.local.env and set their *_ENV_FILE selectors accordingly.
API_ENV_FILE=./config/api.env.example
WEB_ENV_FILE=./config/web.env.example
RAG_ENV_FILE=./config/rag.env.example
VOICE_AGENT_ENV_FILE=./config/voice-agent.env.example
AGGREGATOR_ENV_FILE=./config/aggregator.env.example
ADAPTOR_ENV_FILE=./config/adaptor.env.example
VOICE_AGENT_CONFIG_FILE=./config/voice-agent.local.example.yaml

# Application host ports
API_PORT=8000
API_GRPC_PORT=8080
RAG_PORT=8001
VOICE_AGENT_METRICS_PORT=19091
AGGREGATOR_PORT=3001
